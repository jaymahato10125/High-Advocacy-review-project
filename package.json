{
  "name": "proof-desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "start": "npm start -w apps/api",
    "start:api": "npm start -w apps/api",
    "start:web": "npm run serve -w apps/web",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "test": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
